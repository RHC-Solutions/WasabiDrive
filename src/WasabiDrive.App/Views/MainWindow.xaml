<Window x:Class="WasabiDrive.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:WasabiDrive.App.Views"
        mc:Ignorable="d"
        Title="WasabiDrive" Height="520" Width="860" MinWidth="640" MinHeight="380"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <conv:NullToBoolConverter x:Key="NullToBool"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <DockPanel Margin="12">

        <!-- Toolbar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Add…" Click="OnAdd" Padding="14,6" Margin="0,0,8,0"/>
            <Button Content="Edit…" Click="OnEdit" Padding="14,6" Margin="0,0,8,0"
                    IsEnabled="{Binding SelectedMapping, Converter={StaticResource NullToBool}}"/>
            <Button Content="Delete" Click="OnDelete" Padding="14,6" Margin="0,0,8,0"
                    IsEnabled="{Binding SelectedMapping, Converter={StaticResource NullToBool}}"/>
            <Button Content="Settings…" Click="OnSettings" Padding="14,6" Margin="0,0,8,0"/>
            <Button Content="About…" Click="OnAbout" Padding="14,6"/>
        </StackPanel>

        <!-- rclone warning banner -->
        <Border DockPanel.Dock="Top" Background="#FFF3CD" BorderBrush="#FFE69C" BorderThickness="1"
                Padding="10,6" Margin="0,0,0,10"
                Visibility="{Binding HasRcloneWarning, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding RcloneWarning}" TextWrapping="Wrap" Foreground="#664D03"/>
        </Border>

        <!-- Log pane -->
        <GroupBox DockPanel.Dock="Bottom" Header="Activity log" Height="150" Margin="0,10,0,0">
            <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap"
                     Background="#1E1E1E" Foreground="#DCDCDC"/>
        </GroupBox>

        <!-- Mappings list -->
        <ListView ItemsSource="{Binding Mappings}" SelectedItem="{Binding SelectedMapping}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="150" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Bucket" Width="150" DisplayMemberBinding="{Binding BucketName}"/>
                    <GridViewColumn Header="Drive" Width="60" DisplayMemberBinding="{Binding DriveTarget}"/>
                    <GridViewColumn Header="Region" Width="110" DisplayMemberBinding="{Binding RegionCode}"/>
                    <GridViewColumn Header="Status" Width="110" DisplayMemberBinding="{Binding StateText}"/>
                    <GridViewColumn Header="" Width="170">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Mount" Command="{Binding MountCommand}"
                                            Padding="10,3" Margin="0,0,6,0" MinWidth="70"/>
                                    <Button Content="Unmount" Command="{Binding UnmountCommand}"
                                            Padding="10,3" MinWidth="70"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
