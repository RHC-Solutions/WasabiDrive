<Window x:Class="WasabiDrive.App.Views.MappingEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:WasabiDrive.App.Views"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        mc:Ignorable="d"
        ui:WindowHelper.UseModernWindowStyle="True"
        Background="{StaticResource WC.Brush.BgPrimary}"
        Title="{Binding Title}" Width="480" SizeToContent="Height" Icon="/Assets/wasabidrive.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:MappingModeToDisplayConverter x:Key="ModeToText"/>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Foreground" Value="{StaticResource WC.Brush.TextPrimary}"/>
            <Setter Property="FontFamily" Value="{StaticResource WC.Font.Sans}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="Control" x:Key="Field">
            <Setter Property="Margin" Value="0,4"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Display name"/>
            <!-- PropertyChanged, not the LostFocus default: the folder-location preview below is
                 derived from this and should follow what you type. -->
            <TextBox   Grid.Row="0" Grid.Column="1" Margin="0,4"
                       Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Mode" VerticalAlignment="Top" Margin="0,8,10,0"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,4">
                <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}"
                          ToolTip="Drive letter (rclone/WinFsp) or an on-demand folder (Windows Files On-Demand).">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource ModeToText}}" Margin="0"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding ModeDescription}" TextWrapping="Wrap" Margin="0,4,0,0"
                           FontSize="11" Foreground="{StaticResource WC.Brush.TextSecondary}"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Bucket name *"/>
            <!-- Also feeds the folder preview: it is the fallback leaf when there is no display name. -->
            <TextBox   Grid.Row="2" Grid.Column="1" Margin="0,4"
                       Text="{Binding BucketName, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Sub-path (optional)"/>
            <TextBox   Grid.Row="3" Grid.Column="1" Margin="0,4" Text="{Binding SubPath}"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Region *"/>
            <ComboBox  Grid.Row="4" Grid.Column="1" Margin="0,4"
                       ItemsSource="{Binding Regions}" DisplayMemberPath="DisplayName"
                       SelectedValuePath="RegionCode" SelectedValue="{Binding RegionCode}"/>

            <!-- Drive-letter mode -->
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Drive letter *"
                       Visibility="{Binding IsDriveLetterMode, Converter={StaticResource BoolToVis}}"/>
            <ComboBox  Grid.Row="5" Grid.Column="1" Margin="0,4"
                       ItemsSource="{Binding AvailableDriveLetters}" SelectedItem="{Binding DriveLetter}"
                       Visibility="{Binding IsDriveLetterMode, Converter={StaticResource BoolToVis}}"/>

            <!-- On-demand folder mode -->
            <TextBlock Grid.Row="6" Grid.Column="0" Text="Folder location"
                       VerticalAlignment="Top" Margin="0,8,10,0"
                       Visibility="{Binding IsOnDemandMode, Converter={StaticResource BoolToVis}}"/>
            <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,4"
                        Visibility="{Binding IsOnDemandMode, Converter={StaticResource BoolToVis}}">
                <!-- The resolved path, always shown so the location is never a mystery. -->
                <TextBox Text="{Binding EffectiveFolderPath, Mode=OneWay}" IsReadOnly="True"
                         TextWrapping="Wrap"
                         ToolTip="The folder that will appear in Explorer for this bucket."/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Change…" Click="OnBrowseFolder" Padding="12,3" Margin="0,0,6,0"/>
                    <Button Content="Use default" Click="OnUseDefaultFolder" Padding="12,3"
                            IsEnabled="{Binding UsesCustomFolder}"/>
                </StackPanel>
                <!-- Keep this on one line: a newline inside the attribute survives into the rendered
                     text as a run of spaces rather than being collapsed. -->
                <TextBlock Text="Files appear here as placeholders and download when opened. Pick a location with room for whatever you pin."
                           TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11"
                           Foreground="{StaticResource WC.Brush.TextSecondary}"/>
            </StackPanel>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Access key *"/>
            <TextBox   Grid.Row="7" Grid.Column="1" Margin="0,4" Text="{Binding AccessKeyId}"/>

            <TextBlock Grid.Row="8" Grid.Column="0" Text="Secret key *"/>
            <PasswordBox Grid.Row="8" Grid.Column="1" Margin="0,4" x:Name="SecretBox"/>

            <TextBlock Grid.Row="9" Grid.Column="0" Text="Auto-mount at login"/>
            <CheckBox  Grid.Row="9" Grid.Column="1" Margin="0,6" IsChecked="{Binding AutoMount}"
                       VerticalAlignment="Center"/>

            <Separator Grid.Row="10" Grid.ColumnSpan="2" Margin="0,10"/>

            <TextBlock Grid.Row="11" Grid.Column="0" Text="Cache mode"/>
            <ComboBox  Grid.Row="11" Grid.Column="1" Margin="0,4"
                       ItemsSource="{Binding CacheModes}" SelectedItem="{Binding CacheMode}"/>

            <TextBlock Grid.Row="12" Grid.Column="0" Text="Cache max size (MiB)"/>
            <TextBox   Grid.Row="12" Grid.Column="1" Margin="0,4" Text="{Binding VfsCacheMaxSizeMb}"
                       ToolTip="0 = unlimited. 1 TiB = 1048576."/>

            <TextBlock Grid.Row="13" Grid.Column="0" Text="Cache max age (hours)"/>
            <TextBox   Grid.Row="13" Grid.Column="1" Margin="0,4" Text="{Binding VfsCacheMaxAgeHours}"
                       ToolTip="Also the idle window before on-demand files are freed from disk."/>

            <TextBlock Grid.Row="14" Grid.Column="0" Text="Buffer size (MiB)"/>
            <TextBox   Grid.Row="14" Grid.Column="1" Margin="0,4" Text="{Binding BufferSizeMb}"/>

            <TextBlock Grid.Row="15" Grid.Column="0" Text="Cache location"/>
            <DockPanel Grid.Row="15" Grid.Column="1" Margin="0,4">
                <Button DockPanel.Dock="Right" Content="Browse…" Click="OnBrowseCacheDir"
                        Padding="10,2" Margin="6,0,0,0"/>
                <TextBox Text="{Binding CacheDir}"
                         ToolTip="Drive-letter mode only. Folder for the on-disk cache. Blank = rclone default."/>
            </DockPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save" Click="OnSave" IsDefault="True" Style="{StaticResource WC.Button.Accent}" Padding="18,6" Margin="0,0,8,0"/>
            <Button Content="Cancel" IsCancel="True" Padding="18,6"/>
        </StackPanel>
    </StackPanel>
</Window>
