<Window x:Class="WasabiDrive.App.Views.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        mc:Ignorable="d"
        ui:WindowHelper.UseModernWindowStyle="True"
        Background="{StaticResource WC.Brush.BgPrimary}"
        Title="WasabiDrive" Width="480" SizeToContent="Height" Icon="/Assets/wasabidrive.ico"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="True">
    <StackPanel Margin="20">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap"/>
        <TextBox x:Name="InputBox" Margin="0,10,0,0" Padding="6,4"
                 KeyDown="OnKeyDown"/>
        <TextBlock x:Name="HintText" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                   Foreground="{StaticResource WC.Brush.TextSecondary}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" Click="OnOk" Style="{StaticResource WC.Button.Accent}"
                    Padding="18,6" MinWidth="90" Margin="0,0,8,0" IsDefault="True"/>
            <Button Content="Cancel" IsCancel="True" Padding="18,6" MinWidth="90"/>
        </StackPanel>
    </StackPanel>
</Window>
